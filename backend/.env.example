# === Rust Radar Backend ===
PORT=3001
# APP_URL = публичный адрес САЙТА (фронтенда) — через него идут Steam-вход и куки.
# Локально: http://localhost:5173 · На хостинге: адрес задеплоенного фронтенда
APP_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-to-random-string

# MongoDB. Оставь пустым в dev — автоматически поднимется in-memory MongoDB
# (данные пропадают при перезапуске). Для прод: mongodb://127.0.0.1:27017/rust-radar
MONGO_URI=

# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Можно переопределить базу Steam API (для моков/тестов)
# STEAM_API_BASE=https://api.steampowered.com

# Интервалы опроса (мс): обычный цикл и ускоренный, пока кто-то из врагов в игре
TRACK_INTERVAL_MS=60000
TRACK_FAST_INTERVAL_MS=20000
A2S_TIMEOUT_MS=8000

# Запускать первый цикл сканирования сразу после старта сервера (true/false)
TRACK_ON_BOOT=true

# Rust AppID в Steam (не менять)
RUST_APP_ID=252490

# Telegram-бот (опционально): создать бота у @BotFather, токен вставить сюда.
# Без токена бот просто отключён, всё остальное работает.
TELEGRAM_BOT_TOKEN=
